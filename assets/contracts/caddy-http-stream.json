    "instanceUnavailable": "Plugin instance недоступен для Stream.",
    "invalidContext": "Контекст plugin Stream некорректен.",
    "invalidMessage": "Plugin Stream вернул некорректное сообщение.",
    "invalidMetadata": "Plugin Stream вернул некорректные response metadata.",
    "invalidRequest": "Запрос plugin Stream некорректен.",
    "requestTooLarge": "Размер тела запроса превышает допустимый предел.",
