{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liapoldus.github.io/spec/site.schema.json",
  "title": "Liapoldus site.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
    "index": { "type": "string", "default": "index.html", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "spa": { "type": "boolean", "default": false },
    "locales": { "type": "array", "default": [], "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" } },
    "defaultLocale": { "type": "string" },
    "redirects": {
      "type": "array", "default": [], "items": {
        "type": "object", "additionalProperties": false, "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "pattern": "^/" },
          "to": { "type": "string", "pattern": "^/" },
          "status": { "type": "integer", "enum": [301, 302, 307, 308], "default": 308 }
        }
      }
    },
    "headers": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "response": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "set": { "type": "object", "additionalProperties": { "type": "string" } },
            "setIfAbsent": { "type": "object", "additionalProperties": { "type": "string" } },
            "delete": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "cache": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "static": {
          "type": "object", "additionalProperties": false, "required": ["visibility", "maxAge"],
          "properties": {
            "visibility": { "enum": ["public", "private", "no-store"] },
            "maxAge": { "type": "string", "pattern": "^[0-9]+(?:ns|us|µs|ms|s|m|h|d)$" }
          }
        }
      }
    }
  },
  "x-liapoldus-semanticValidation": {
    "defaultLocaleMustBeListed": true,
    "code": "site_invalid",
    "description": "При наличии defaultLocale его значение должно точно совпадать с одним из locales. Это межполевое правило проверяет Gateway после JSON Schema; $data и иные расширения валидатора не используются."
  }
}
