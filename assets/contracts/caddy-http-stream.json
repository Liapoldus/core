  "setCookieHeader": "Set-Cookie",
  "sseEventPrefix": "event: ",
  "sseIDPrefix": "id: ",
  "sseRetryPrefix": "retry: ",
  "sseDataPrefix": "data: ",
  "sseLineEnding": "\n",
  "sseEventEnding": "\n",
  "contextVersionField": "version",
  "contextKindField": "kind",
  "contextMethodField": "method",
  "contextPathField": "path",
  "contextQueryField": "query",
  "contextHeadersField": "headers",
  "contextRequestIDField": "requestId",
  "contextRemoteAddrField": "remoteAddr",
  "contextContextField": "context",
  "contextCookiesField": "cookies",
  "contextOfferedSubprotocolsField": "offeredSubprotocols",
  "metadataStatusField": "status",
  "metadataHeadersField": "headers",
  "metadataVersionField": "version",
  "cookieHeader": "Cookie",
  "websocketSubprotocolHeader": "Sec-WebSocket-Protocol",
  "invalidSSECharacters": "\r\n\u0000",
