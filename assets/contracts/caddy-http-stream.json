{
  "app": "liapoldus",
  "directive": "liapoldus_plugin",
  "orderAnchor": "respond",
  "handlerModule": "http.handlers.liapoldus_stream",
  "callMode": "call",
  "httpStreamMode": "http-stream",
  "websocketMode": "websocket",
  "sseMode": "sse",
  "httpKind": "http",
  "websocketKind": "websocket",
  "sseKind": "sse",
  "version": 1,
  "defaultStreamStatus": 200,
  "maxRequestBytes": 10485760,
