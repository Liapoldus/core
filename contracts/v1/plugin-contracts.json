{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liapoldus.github.io/spec/plugin-contracts.json",
  "title": "Liapoldus plugin capability contracts",
  "version": "1.0.0",
  "httpCapabilityEnvelope": {
    "request": { "type": "object", "additionalProperties": false, "required": ["request", "body"], "properties": {
      "request": { "type": "object", "additionalProperties": false, "properties": { "method": { "type": "string" }, "path": { "type": "string" }, "query": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }, "headers": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } } } },
      "context": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Ограниченный контекст, сформированный Gateway; контракт конкретной capability определяет его поля." },
      "waf": { "type": "object", "additionalProperties": false, "required": ["requestSize"], "properties": { "headers": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }, "query": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }, "requestSize": { "type": "integer", "minimum": 0 } }, "description": "Контекст общего WAF-вызова; заголовки Authorization, Cookie и Proxy-Authorization исключены." },
      "body": { "oneOf": [{ "type": "null" }, { "type": "object" }, { "type": "string", "contentEncoding": "base64" }] },
      "grants": { "type": "array", "items": { "$ref": "#/$defs/grant" } }
    } },
    "response": { "type": "object", "additionalProperties": false, "required": ["status", "headers", "body"], "properties": { "status": { "type": "integer", "minimum": 100, "maximum": 599 }, "headers": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }, "cookies": { "type": "array", "items": { "type": "string" }, "description": "Отдельные Set-Cookie actions; Gateway передаёт каждую запись без объединения." }, "body": { "oneOf": [{ "type": "null" }, { "type": "object" }, { "type": "string", "contentEncoding": "base64" }] } } }
  },
  "streamContract": { "source": "https://github.com/Liapoldus/pluginprotocol/tree/main/proto/liapoldus/plugin/v1", "openContextSchema": "https://github.com/Liapoldus/pluginprotocol/blob/main/contracts/protocol/v1/stream-open-context.schema.json", "payload": "Protocol-owned gRPC messages carry raw byte payloads; this documentation contract does not redefine transport messages." },
  "errors": { "validation_failed": { "http": 422, "retryable": false }, "not_found": { "http": 404, "retryable": false }, "duplicate": { "http": 409, "retryable": false }, "storage_unavailable": { "http": 503, "retryable": true }, "resource_exhausted": { "http": 503, "retryable": true } },
  "wafDecision": { "type": "object", "additionalProperties": false, "oneOf": [{ "required": ["continue"], "properties": { "continue": { "const": true } } }, { "required": ["continue", "response"], "properties": { "continue": { "const": false }, "response": { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "type": "integer", "minimum": 100, "maximum": 599 }, "headers": { "type": "object", "additionalProperties": { "type": "string" } }, "cookies": { "type": "array", "items": { "type": "string" } }, "body": { "type": "string", "contentEncoding": "base64" } } } } }] },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "grant": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "purpose", "expiresAt", "handle"], "properties": { "id": { "pattern": "^grant_[A-Za-z0-9_-]+$" }, "kind": { "enum": ["storage", "secret"] }, "purpose": { "type": "string" }, "expiresAt": { "format": "date-time" }, "handle": { "type": "string" } } }
  }
}
