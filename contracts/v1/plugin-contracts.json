{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liapoldus.github.io/spec/plugin-contracts.json",
  "title": "Liapoldus plugin capability contracts",
  "version": "1.0.0",
  "httpCapabilityEnvelope": {
    "request": { "type": "object", "additionalProperties": false, "required": ["request", "body"], "properties": {
      "request": { "type": "object", "additionalProperties": false, "properties": { "method": { "type": "string" }, "path": { "type": "string" }, "query": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }, "headers": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } } } },
      "identity": { "type": "object", "additionalProperties": false, "properties": { "subject": { "type": "string" }, "claims": { "type": "object", "additionalProperties": true } } },
      "body": { "oneOf": [{ "type": "null" }, { "type": "object" }, { "type": "string", "contentEncoding": "base64" }] },
      "grants": { "type": "array", "items": { "$ref": "#/$defs/grant" } }
    } },
    "response": { "type": "object", "additionalProperties": false, "required": ["status", "headers", "body"], "properties": { "status": { "type": "integer", "minimum": 100, "maximum": 599 }, "headers": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }, "body": { "oneOf": [{ "type": "null" }, { "type": "object" }, { "type": "string", "contentEncoding": "base64" }] } } }
  },
  "streamEncoding": { "tcp": "STREAM_DATA Envelope.payload is raw bytes. STREAM_OPEN payload is UTF-8 JSON {kind:'tcp',source:'ip:port',destination:'ip:port',sni?:string,alpn?:string}.", "udp": "Each datagram is one STREAM_DATA Frame. Envelope.payload is raw datagram bytes, never base64; STREAM_OPEN is UTF-8 JSON {kind:'udp',source:'ip:port',destination:'ip:port'}." },
  "errors": { "validation_failed": { "http": 422, "retryable": false }, "not_found": { "http": 404, "retryable": false }, "duplicate": { "http": 409, "retryable": false }, "storage_unavailable": { "http": 503, "retryable": true }, "resource_exhausted": { "http": 503, "retryable": true } },
  "formsStorage": { "schemaRegistration": "An instance configuration declares schemas as a map schemaName -> JSON Schema Draft 2020-12. publish/config.apply validates every schema before it becomes active.", "tables": { "form_schemas": ["site", "schema_name", "schema_json", "updated_at"], "form_submissions": ["id", "site", "schema_name", "created_at", "data_json"] }, "keys": { "form_schemas": "PRIMARY KEY(site, schema_name)", "form_submissions": "PRIMARY KEY(id); INDEX(site, schema_name, created_at DESC, id DESC)" }, "ordering": "forms.list is descending created_at, then descending opaque id. Cursor encodes the final tuple and schema revision, is HMAC-protected and invalid after schema revision changes.", "transactions": "submit validates then inserts atomically. delete deletes exactly one matching (site,schemaName,id); a missing row returns not_found." },
  "capabilities": {
    "forms.submit": { "request": { "type": "object", "additionalProperties": false, "required": ["site", "schemaName", "data"], "properties": { "site": { "$ref": "#/$defs/name" }, "schemaName": { "$ref": "#/$defs/schemaName" }, "data": { "type": "object", "maxProperties": 256 } } }, "response": { "type": "object", "additionalProperties": false, "required": ["id", "createdAt", "data"], "properties": { "id": { "pattern": "^frm_[A-Za-z0-9_-]+$" }, "createdAt": { "format": "date-time" }, "data": { "type": "object" } } } },
    "forms.list": { "request": { "type": "object", "additionalProperties": false, "required": ["site", "schemaName"], "properties": { "site": { "$ref": "#/$defs/name" }, "schemaName": { "$ref": "#/$defs/schemaName" }, "cursor": { "type": "string" }, "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }, "filter": { "type": "object", "additionalProperties": false, "required": ["field", "equals"], "properties": { "field": { "type": "string" }, "equals": {} } } } }, "response": { "type": "object", "additionalProperties": false, "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/$defs/formItem" } }, "nextCursor": { "type": ["string", "null"] } } } },
    "forms.delete": { "request": { "type": "object", "additionalProperties": false, "required": ["site", "schemaName", "id"], "properties": { "site": { "$ref": "#/$defs/name" }, "schemaName": { "$ref": "#/$defs/schemaName" }, "id": { "pattern": "^frm_[A-Za-z0-9_-]+$" } } }, "response": { "type": "object", "additionalProperties": false, "required": ["deleted", "id"], "properties": { "deleted": { "const": true }, "id": { "type": "string" } } } },
    "captcha.verify": { "request": { "type": "object", "additionalProperties": false, "required": ["token", "provider"], "properties": { "token": { "type": "string", "minLength": 1, "maxLength": 16384 }, "provider": { "type": "string" }, "remoteIp": { "type": "string" } } }, "response": { "type": "object", "additionalProperties": false, "required": ["valid"], "properties": { "valid": { "type": "boolean" }, "providerCode": { "type": "string" } } } },
    "tls.issue": { "$ref": "#/$defs/tlsOperation" }, "tls.renew": { "$ref": "#/$defs/tlsOperation" }, "tls.revoke": { "$ref": "#/$defs/tlsOperation" }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "schemaName": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "grant": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "purpose", "expiresAt", "handle"], "properties": { "id": { "pattern": "^grant_[A-Za-z0-9_-]+$" }, "kind": { "enum": ["storage", "secret"] }, "purpose": { "type": "string" }, "expiresAt": { "format": "date-time" }, "handle": { "type": "string" } } },
    "formItem": { "type": "object", "additionalProperties": false, "required": ["id", "createdAt", "data"], "properties": { "id": { "type": "string" }, "createdAt": { "format": "date-time" }, "data": { "type": "object" } } },
    "tlsOperation": { "request": { "type": "object", "additionalProperties": false, "required": ["issuer", "domains"], "properties": { "issuer": { "$ref": "#/$defs/name" }, "domains": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "certificateHandle": { "type": "string" }, "reason": { "type": "string" } } }, "response": { "type": "object", "additionalProperties": false, "required": ["orderId", "certificate"], "properties": { "orderId": { "type": "string" }, "certificate": { "type": "object", "additionalProperties": false, "required": ["chainPem", "privateKeyPem", "notAfter"], "properties": { "chainPem": { "type": "string" }, "privateKeyPem": { "type": "string" }, "notAfter": { "format": "date-time" } } } } } }
  }
}
